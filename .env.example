# Copy to .env and fill in real values. NEVER commit .env.
# Variable names must match what server.js / admin-server.js read.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

SMTP_USER=your-business-gmail@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

AES_SEED=set-a-long-random-secret-string

PORT=3000
ALLOWED_ORIGINS=https://your-live-domain.com,http://localhost:3000,http://localhost:8080
